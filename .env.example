# Public URLs used by the browser.
# Local defaults:
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
SFU_PUBLIC_URL=http://localhost:4000

# For production with Cloudflare/subdomains, use values like:
# APP_PUBLIC_URL=https://meet.example.com
# API_PUBLIC_URL=https://meet-api.example.com
# SFU_PUBLIC_URL=https://meet-sfu.example.com

# Comma-separated browser origins allowed by API and SFU signaling.
CORS_ORIGINS=http://localhost:5173

# Host ports exposed by Docker Compose.
FRONTEND_PORT=5173
API_PORT=3000
SFU_PORT=4000

# RTP ports used by mediasoup. Open/forward these on the Raspberry/router.
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# Local Docker uses 127.0.0.1. On a Raspberry exposed to the internet, set this
# to the public IP of the Raspberry/router. Do not use a Cloudflare-proxied DNS
# name for RTP candidates.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# Optional: comma-separated candidates for mixed LAN/WAN testing.
# Example: MEDIASOUP_ANNOUNCED_IPS=179.7.15.8,192.168.1.50
MEDIASOUP_ANNOUNCED_IPS=127.0.0.1
